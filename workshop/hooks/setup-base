#!/bin/bash
# setup-base hook — configure PATH for all course tools.
#
# This runs once when the Workshop is first launched.
# Pattern from: https://github.com/canonical/ollama-sdk

set -e

# Add all SDK binaries to PATH system-wide
cat <<EOF >/etc/profile.d/course-platform.sh
export PATH="\$SDK/bin:\$PATH"
EOF

# Initialize LXD if not already done (inside the Workshop container)
# LXD is needed for Juju to bootstrap a localhost controller
if ! lxc info >/dev/null 2>&1; then
  lxd init --auto \
    --storage-backend=zfs \
    --storage-pool=workshop-zfs 2>/dev/null || true
fi

# Ensure the default profile has a root disk
if ! lxc profile show default 2>/dev/null | grep -q "root:"; then
  lxc profile device add default root disk path=/ pool=workshop-zfs 2>/dev/null || true
fi
