#!/bin/bash
# setup-project hook — install and start the course platform services.
#
# This runs after setup-base, when the Workshop is launched.
# Starts Postgres + the course backend (which auto-discovers courses from
# the content directory and auto-migrates the DB via GORM).

set -e

# Initialize Postgres data directory if needed
PGDATA="$HOME/share/postgres-data"
mkdir -p "$PGDATA"
if [ ! -f "$PGDATA/PG_VERSION" ]; then
  initdb -D "$PGDATA" --auth=trust >/dev/null 2>&1
fi

# Start Postgres (if not already running)
if ! pg_ctl status -D "$PGDATA" >/dev/null 2>&1; then
  pg_ctl start -D "$PGDATA" -l "$HOME/share/postgres.log" -o "-p 5432" >/dev/null 2>&1
  # Wait for Postgres to be ready
  for i in $(seq 1 10); do
    if psql -p 5432 -c "SELECT 1" >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
fi

# Create the course database if it doesn't exist
psql -p 5432 -c "CREATE DATABASE course" >/dev/null 2>&1 || true

# Install the systemd service file for the backend
install -D --mode=644 --target-directory ~/.config/systemd/user \
  "$SDK/services/course-backend.service"

# Reload systemd and enable the service
systemctl --user daemon-reload
systemctl --user enable --now course-backend.service

# Wait for the backend to be ready (up to 15 seconds)
for i in $(seq 1 15); do
  if curl -s http://localhost:8080/api/courses >/dev/null 2>&1; then
    echo "Course platform is ready at http://localhost:8080"
    exit 0
  fi
  sleep 1
done

echo "WARNING: Course backend did not become ready in 15 seconds"
echo "Check: systemctl --user status course-backend"
