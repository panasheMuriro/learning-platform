#!/bin/bash
# check-health hook — verify the course platform is healthy.
#
# Pattern from: https://github.com/canonical/ollama-sdk

set -e

# Check that the backend is responding
if ! output=$(curl -s http://localhost:8080/api/courses 2>&1); then
  workshopctl set-health waiting "Course backend not responding: $output"
  exit 0
fi

# Check that juju is available
if ! juju version >/dev/null 2>&1; then
  workshopctl set-health waiting "juju not available"
  exit 0
fi

# Check that terraform is available
if ! terraform version >/dev/null 2>&1; then
  workshopctl set-health waiting "terraform not available"
  exit 0
fi

workshopctl set-health okay
