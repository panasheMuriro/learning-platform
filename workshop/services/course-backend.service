[Unit]
Description=Course Platform Backend
After=network.target

[Service]
ExecStart=/bin/bash -lc "course-server --addr :8080 --content-root ${HOME}/share/course-content --lab-root ${HOME} --db-dsn postgres://course@localhost:5432/course?sslmode=disable"
Restart=always
RestartSec=3
Environment=HOME=%h

[Install]
WantedBy=default.target
